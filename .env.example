# AI Mirror — environment configuration
# Copy to .env and adjust as needed.

APP_ENV=local

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OLLAMA_PORT=11434

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ai_mirror_local

# --- LLM provider ---
# Options: claude_cli | openai | anthropic | grok (alias: xai) | ollama
# claude_cli shells out to the local `claude` binary (subscription OAuth,
# no API key on disk) — the local-first default. Requires a native backend
# run (uvicorn), not the Docker container.
LLM_PROVIDER=claude_cli
LLM_MODEL=claude-sonnet-4-6
CLAUDE_CLI_BIN=claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
OLLAMA_BASE_URL=http://ollama:11434

# --- Fable mode (tiered models) ---
# true → scaffold work (summaries, epoch profiles, extraction) uses
# SCAFFOLD_MODEL; judgment work (synthesis, trajectories, meta-analysis,
# adversarial critique) uses HARD_MODEL. Report endpoints can override
# per-request with {"fable": true|false}.
FABLE_MODE=false
SCAFFOLD_MODEL=claude-sonnet-4-6
HARD_MODEL=claude-fable-5
LLM_MAX_CONCURRENCY=3

# --- Remote ingestion ---
# Colon-separated roots POST /ingest/remote may read. Anything outside is
# rejected. Embeddings are computed locally by ChromaDB's bundled model.
INGEST_ALLOWED_ROOTS=~/.claude/projects:~/.openclaw/agents

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
